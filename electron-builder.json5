// @see https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "YourAppID",
  "asar": true,
  "asarUnpack": [
    "dist-electron/main/ocrWorker.mjs",
    "node_modules/**",
    "**/node_modules/.prisma/client/**",
    "**/node_modules/@prisma/engines/**"
  ],
  "productName": "搬砖记录器",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "node_modules/.prisma/**",
    "node_modules/@prisma/client/**"
  ],
  "extraResources": [
    {
      "from": "node_modules/.prisma/client",
      "to": "app.asar.unpacked/node_modules/.prisma/client"
    }
  ],
  "mac": {
    "target": [
      "dmg", "zip"
    ],
    "artifactName": "mhxy-tools-Mac-${version}-Installer.${ext}",
    "icon": "build/icons/icon.icns"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "mhxy-tools-Windows-${version}-Setup.${ext}",
    "icon": "build/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "dist/icon.ico"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "mhxy-tools-Linux-${version}.${ext}",
    "icon": "build/icons/512x512.png"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "zhanyis",
      "repo": "mhxy_tools_electron",
      "releaseType": "release"
    }
  ]
}
